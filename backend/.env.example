# PostgreSQL
POSTGRES_DB=corrientazo
POSTGRES_USER=corrientazo
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD

# Prisma / app
DATABASE_URL=postgresql://corrientazo:CHANGEME_STRONG_PASSWORD@postgres:5432/corrientazo?schema=public
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=CHANGEME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGEME_REFRESH_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Ports (internos)
PORT=3000

# Socket.io / CORS (ajustar)
SOCKETIO_NAMESPACE=/realtime

# Push (futuro)
FCM_API_KEY=CHANGEME
APNS_KEY_ID=CHANGEME

# Pagos (futuro)
NEQUI_API_KEY=CHANGEME
NEQUI_WEBHOOK_SECRET=CHANGEME
DAVIPLATA_API_KEY=CHANGEME
DAVIPLATA_WEBHOOK_SECRET=CHANGEME

# Admin bootstrap (si aplica)
ADMIN_BOOTSTRAP_KEY=CHANGEME

