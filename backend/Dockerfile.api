#
# Dockerfile API (NestJS) — CORRIENTAZO MVP
#
# El dist SIEMPRE sale de `npm run build` en la stage builder (no copies dist desde el host).
# Para saber qué código lleva la imagen: pasá GIT_COMMIT / BUILD_TIME al build (ver docker-compose).
#
FROM node:20-alpine AS deps
WORKDIR /app

COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Cache busting: cualquier cambio en el repo invalida esta capa → rebuild real del dist.
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

ENV NODE_ENV=production \
    APP_GIT_COMMIT=${GIT_COMMIT} \
    APP_BUILD_TIME=${BUILD_TIME}

# Healthcheck confiable (wget busybox a veces falla por IPv6/localhost; curl es explícito).
RUN apk add --no-cache curl

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.mjs ./prisma.config.mjs

LABEL org.opencontainers.image.revision="${GIT_COMMIT}"

CMD ["npm", "run", "start:api"]
